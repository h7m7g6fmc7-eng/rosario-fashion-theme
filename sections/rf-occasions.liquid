{%- comment -%} Rosario Fashion — shop by occasion tiles {%- endcomment -%}
<section class="rf-occasions">
  <div class="rf-section-head">
    {%- if section.settings.eyebrow != blank -%}<p class="rf-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="rf-h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  </div>
  <div class="rf-occasions__grid">
    {%- assign used_ids = ',' -%}
    {%- for block in section.blocks -%}
      {%- liquid
        assign c = block.settings.collection
        assign img = block.settings.image
        if img == blank and c != blank
          assign img = c.featured_image
          if img == blank and c.products.size > 0
            for p in c.products limit: 12
              assign style_name = p.title | split: ' ' | first | downcase
              assign pid = ',' | append: style_name | append: ','
              unless used_ids contains pid
                if p.featured_media
                  assign img = p.featured_media.preview_image
                  assign used_ids = used_ids | append: pid
                  break
                endif
              endunless
            endfor
          endif
        endif
        assign label = block.settings.label
        if label == blank and c != blank
          assign label = c.title
        endif
        assign tones = '#E4C3CB,#F1E3D6,#EBD3D8,#E9D6CF' | split: ','
        assign tone_index = forloop.index0 | modulo: 4
      -%}
      <a class="rf-tile" href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" {{ block.shopify_attributes }}>
        <div class="rf-tile__media" style="background: {{ tones[tone_index] }};">
          {%- if img != blank -%}
            {{ img | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '360, 540, 720, 900', alt: label }}
          {%- endif -%}
        </div>
        <div class="rf-tile__label">
          <span class="rf-italic">{{ label | escape }}</span>
          <span class="rf-link-caps">Shop</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "RF Shop by occasion",
  "tag": "div",
  "class": "rf-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by occasion" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something for every plan" }
  ],
  "blocks": [
    {
      "type": "occasion",
      "name": "Occasion",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (optional)" },
        { "type": "text", "id": "label", "label": "Label (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RF Shop by occasion",
      "blocks": [
        { "type": "occasion" },
        { "type": "occasion" },
        { "type": "occasion" },
        { "type": "occasion" }
      ]
    }
  ]
}
{% endschema %}
