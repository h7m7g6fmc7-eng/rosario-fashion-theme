{%- comment -%} Rosario Fashion — "As worn by you" social grid {%- endcomment -%}
<section class="rf-ugc">
  <div class="rf-section-head">
    {%- if section.settings.eyebrow != blank -%}<p class="rf-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="rf-h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
  </div>
  <div class="rf-ugc__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tones = '#EBD3D8,#F1E3D6,#E4C3CB,#F3E6E8,#E9D6CF,#EBD3D8' | split: ','
        assign t = forloop.index0 | modulo: 6
      -%}
      {%- if block.settings.link != blank -%}<a class="rf-ugc__item" href="{{ block.settings.link }}" style="background: {{ tones[t] }};" {{ block.shopify_attributes }}>{%- else -%}<div class="rf-ugc__item" style="background: {{ tones[t] }};" {{ block.shopify_attributes }}>{%- endif -%}
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 17vw, 33vw', widths: '300, 450, 600', alt: block.settings.image.alt }}
        {%- endif -%}
      {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "RF Social grid",
  "tag": "div",
  "class": "rf-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "@rosariofashion" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "As worn by you" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    { "name": "RF Social grid", "blocks": [{ "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }] }
  ]
}
{% endschema %}
