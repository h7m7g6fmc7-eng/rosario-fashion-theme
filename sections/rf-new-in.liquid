{%- comment -%} Rosario Fashion — edge-to-edge product grid with filter chips {%- endcomment -%}
{%- assign c = section.settings.collection -%}
<section class="rf-new-in">
  <div class="rf-new-in__head page-width">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="rf-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="rf-h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <nav class="rf-filters" aria-label="{{ section.settings.heading | escape }} filters">
        {%- for block in section.blocks -%}
          {%- assign bc = block.settings.collection -%}
          <a class="rf-filter{% if bc != blank and bc.handle == c.handle %} is-active{% endif %}" href="{% if bc != blank %}{{ bc.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" {{ block.shopify_attributes }}>
            {{- block.settings.label | default: bc.title | escape -}}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
  <ul class="rf-grid" role="list">
    {%- if c != blank and c.products.size > 0 -%}
      {%- for product in c.products limit: section.settings.products_to_show -%}
        <li class="rf-grid__item">{% render 'rf-card', product: product %}</li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.products_to_show) -%}
        <li class="rf-grid__item">
          <div class="rf-card"><div class="rf-card__media rf-placeholder" aria-hidden="true"></div>
            <div class="rf-card__info"><span class="rf-card__title">Product name</span><span class="rf-card__price">$0.00</span></div>
          </div>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
  {%- if section.settings.view_all_label != blank -%}
    <div class="rf-center">
      <a class="rf-btn rf-btn--outline" href="{% if c != blank %}{{ c.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ section.settings.view_all_label | escape }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "RF Product grid",
  "tag": "div",
  "class": "rf-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Just landed" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New In" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 16, "step": 4, "default": 8 },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all new in" }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filter chip",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label (optional)" }
      ]
    }
  ],
  "presets": [{ "name": "RF Product grid" }]
}
{% endschema %}
