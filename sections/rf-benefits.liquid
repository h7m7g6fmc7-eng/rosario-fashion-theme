{%- comment -%} Rosario Fashion — trust / benefits row {%- endcomment -%}
<section class="rf-benefits">
  {%- capture rf_threshold -%}{% render 'rf-threshold' %}{%- endcapture -%}
  <div class="rf-benefits__grid page-width">
    {%- for block in section.blocks -%}
      <div class="rf-benefit" {{ block.shopify_attributes }}>
        <span class="rf-benefit__title">{{ block.settings.title | escape }}</span>
        {%- if block.settings.text != blank -%}<span class="rf-benefit__text">{{ block.settings.text | escape | replace: '[FREE_SHIPPING]', rf_threshold }}</span>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "RF Benefits",
  "tag": "div",
  "class": "rf-section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "On orders over [FREE_SHIPPING]" }
      ]
    }
  ],
  "presets": [
    { "name": "RF Benefits", "blocks": [{ "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }] }
  ]
}
{% endschema %}
