{%- comment -%}
  Rosario Fashion — full-screen hero with a giant ROSARIO wordmark.
  On the home page the header sits transparent over this image and turns solid on scroll.
{%- endcomment -%}
<section class="rf-hw" style="--rf-hw-word: {{ section.settings.word_color }};">
  <a class="rf-hw__link" href="{{ section.settings.link | default: routes.all_products_collection_url }}" aria-label="{{ section.settings.label | default: section.settings.wordmark | escape }}">
    <div class="rf-hw__media">
      {%- if section.settings.image != blank -%}
        {%- assign hw_alt = section.settings.image.alt | default: section.settings.label -%}
        {%- assign hw_style = 'object-position: center ' | append: section.settings.focus | append: '%;' -%}
        {%- if section.settings.mobile_image != blank -%}
          {{ section.settings.mobile_image | image_url: width: 1400 | image_tag: class: 'rf-hw__img rf-hw__img--mobile', loading: 'eager', sizes: '100vw', widths: '600, 900, 1200, 1400', alt: hw_alt }}
        {%- endif -%}
        {{ section.settings.image | image_url: width: 2800 | image_tag: class: 'rf-hw__img', loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 2000, 2800', alt: hw_alt, style: hw_style }}
      {%- else -%}
        <div class="rf-placeholder" aria-hidden="true"></div>
      {%- endif -%}
    </div>
    <span class="rf-hw__word" aria-hidden="true">{{ section.settings.wordmark | escape }}</span>
    {%- if section.settings.label != blank -%}
      <span class="rf-hw__label">{{ section.settings.label | escape }}</span>
    {%- endif -%}
  </a>
</section>

<script>
  (function () {
    var b = document.body;
    if (!b || b.dataset.rfScrollBound) return;
    b.dataset.rfScrollBound = '1';
    function update() { b.classList.toggle('rf-scrolled', window.scrollY > 40); }
    update();
    window.addEventListener('scroll', update, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "RF Hero (full screen)",
  "tag": "div",
  "class": "rf-section rf-hw-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)" },
    { "type": "range", "id": "focus", "label": "Image vertical focus", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 25 },
    { "type": "text", "id": "wordmark", "label": "Big word", "default": "ROSARIO" },
    { "type": "color", "id": "word_color", "label": "Big word color", "default": "#F6DDE2" },
    { "type": "text", "id": "label", "label": "Label (bottom left)", "default": "NEW IN" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "RF Hero (full screen)" }]
}
{% endschema %}
