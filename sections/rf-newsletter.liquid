{%- comment -%} Rosario Fashion — newsletter on blush {%- endcomment -%}
<section class="rf-newsletter">
  <div class="rf-newsletter__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="rf-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="rf-h2 rf-h2--lg">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="rf-lead">{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- form 'customer', id: 'RfNewsletter', class: 'rf-newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <div class="rf-newsletter__ok" role="status">
          <p>Welcome to the Rosario Circle!</p>
          {%- if section.settings.discount_code != blank -%}
            <p class="rf-newsletter__code-label">Your welcome code:</p>
            <p class="rf-newsletter__code">{{ section.settings.discount_code | escape }}</p>
            <p class="rf-newsletter__small">Use it at checkout on your first order.</p>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="rf-newsletter__field">
          <label class="visually-hidden" for="RfNewsletterEmail">Email address</label>
          <input id="RfNewsletterEmail" type="email" name="contact[email]" required autocomplete="email" placeholder="Email address" value="{{ form.email }}" {% if form.errors %}aria-invalid="true" aria-describedby="RfNewsletterError"{% endif %}>
          <button type="submit" class="rf-btn">{{ section.settings.button_label | escape }}</button>
        </div>
        {%- if form.errors -%}
          <p id="RfNewsletterError" class="rf-newsletter__error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "RF Newsletter",
  "tag": "div",
  "class": "rf-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Rosario Circle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the Rosario Circle" },
    { "type": "text", "id": "text", "label": "Text", "default": "First look at new drops, styling notes and private sales." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join" },
    { "type": "text", "id": "discount_code", "label": "Discount code shown after sign-up (optional)" }
  ],
  "presets": [{ "name": "RF Newsletter" }]
}
{% endschema %}
